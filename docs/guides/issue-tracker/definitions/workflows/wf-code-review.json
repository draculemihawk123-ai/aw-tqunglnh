{
 "schemaVersion": "1",
 "nodes": [
  {
   "key": "start",
   "type": "START",
   "outcomes": [
    "next"
   ]
  },
  {
   "key": "ai-review",
   "type": "AGENT",
   "outcomes": [
    "approved",
    "rework"
   ],
   "agent": {
    "profileRef": {
     "$ref": "agent:agent-reviewer"
    },
    "policyRefs": [
     {
      "$ref": "policy:policy-attempt"
     },
     {
      "$ref": "policy:policy-permission"
     }
    ],
    "adapterBuildId": {
     "$ref": "adapter"
    },
    "role": "CHECKER"
   }
  },
  {
   "key": "review",
   "type": "APPROVAL",
   "outcomes": [
    "approved",
    "rework",
    "rejected"
   ],
   "approval": {
    "authorizedRoles": [
     "operator"
    ],
    "timeoutSeconds": 604800,
    "escalationOutcome": "rejected"
   }
  },
  {
   "key": "reject",
   "type": "COMMAND",
   "outcomes": [
    "done"
   ],
   "command": {
    "commandRef": {
     "$ref": "command:cmd-reject"
    },
    "policyRefs": [
     {
      "$ref": "policy:policy-attempt-once"
     },
     {
      "$ref": "policy:policy-permission"
     }
    ]
   }
  },
  {
   "key": "end",
   "type": "END"
  }
 ],
 "edges": [
  {
   "key": "start-ai-review",
   "from": "start",
   "outcome": "next",
   "to": "ai-review"
  },
  {
   "key": "ai-review-approved-review",
   "from": "ai-review",
   "outcome": "approved",
   "to": "review"
  },
  {
   "key": "ai-review-rework-review",
   "from": "ai-review",
   "outcome": "rework",
   "to": "review"
  },
  {
   "key": "review-approved-end",
   "from": "review",
   "outcome": "approved",
   "to": "end"
  },
  {
   "key": "review-rework-reject",
   "from": "review",
   "outcome": "rework",
   "to": "reject"
  },
  {
   "key": "review-rejected-reject",
   "from": "review",
   "outcome": "rejected",
   "to": "reject"
  },
  {
   "key": "reject-end",
   "from": "reject",
   "outcome": "done",
   "to": "end"
  }
 ],
 "completionPolicyRef": {
  "$ref": "policy:policy-completion-human"
 }
}
