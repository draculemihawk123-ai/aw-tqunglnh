{
  "prefix": "trk-",
  "repository": "contracts",
  "kit": {"path": "../../../kit/kit.json", "version": "1"},
  "provider": {"key": "claude", "model": "sonnet", "configIdentity": "trk-claude", "envAllowlist": ["HOME", "PATH"]},
  "contextBudgetBytes": 65536,
  "messageBudget": {"maxBytes": 32768, "keepLatest": 2},

  "layers": [
    {"id": "layer-openapi-contract", "name": "Layer: hợp đồng OpenAPI (repo contracts)", "file": "definitions/layers/layer-openapi-contract.json"},
    {"id": "layer-api-contract-first", "name": "Layer: api theo hợp đồng (repo api)", "file": "definitions/layers/layer-api-contract-first.json"},
    {"id": "layer-web-contract-first", "name": "Layer: web theo hợp đồng (repo web)", "file": "definitions/layers/layer-web-contract-first.json"}
  ],

  "skills": [
    {"id": "skill-tracker-dev", "name": "Skill: tri thức riêng của issue tracker", "file": "definitions/skills/skill-tracker-dev.json"}
  ],

  "scriptSkills": [
    {"id": "scripts", "name": "Script cho các Command của issue tracker", "owner": "team-platform",
     "files": ["commands/contract-lint.sh", "commands/contract-compat.sh", "commands/api-conformance.sh",
               "commands/web-conformance.sh", "commands/contract-valid-gate.sh"]}
  ],

  "packs": [
    {"id": "pack-contracts", "name": "Pack: hợp đồng OpenAPI", "repository": "contracts",
     "include": ["layer-openapi-contract"], "assignTo": ["spec"]},
    {"id": "pack-api", "name": "Pack: api (Spring Boot + SQLite)", "repository": "api",
     "include": ["layer-stack-spring-sqlite", "layer-api-contract-first"], "assignTo": ["backend"]},
    {"id": "pack-web", "name": "Pack: web (React + Vite)", "repository": "web",
     "include": ["layer-stack-react-vite", "layer-web-contract-first"], "assignTo": ["frontend"]}
  ],

  "policies": [
    {"id": "policy-permission-multirepo", "name": "Permission: nhiều repository (lệnh đọc worktree repo khác)", "file": "definitions/policies/policy-permission-multirepo.json"},
    {"id": "policy-completion-human", "name": "Completion: có người duyệt", "file": "definitions/policies/policy-completion-human.json"},
    {"id": "policy-completion-main-check", "name": "Completion: kiểm tra nhánh chính ba repository", "file": "definitions/policies/policy-completion-main-check.json"}
  ],

  "agents": [
    {"id": "agent-contract", "name": "Agent: đổi hợp đồng",
     "resources": ["layer-openapi-contract", "skill-maker#dev.implement-feature", "skill-maker#dev.definition-of-done",
                   "skill-tracker-dev#dev.stack-overview", "skill-feature-flow#flow.needs-info", "skill-dev-rules#rules.decisions", "skill-dev-rules#rules.finish", "skill-ask#ask.analysis-first", "skill-ask#ask.question-groups", "skill-dev-rules#rules.no-shortcuts", "skill-dev-rules#rules.principles", "skill-dev-rules#rules.stable-artifacts", "skill-debug#debug.root-cause", "skill-debug#debug.hypotheses", "skill-debug#debug.fix-discipline", "skill-debug#debug.red-flags", "layer-api-design"]},
    {"id": "agent-api", "name": "Agent: api",
     "resources": ["skill-feature-flow#flow.needs-info", "layer-stack-spring-sqlite", "layer-api-contract-first", "skill-maker#dev.implement-feature",
                   "skill-maker#dev.definition-of-done", "skill-tracker-dev#dev.stack-overview", "skill-dev-rules#rules.decisions", "skill-dev-rules#rules.finish", "skill-ask#ask.analysis-first", "skill-ask#ask.question-groups", "skill-dev-rules#rules.no-shortcuts", "skill-dev-rules#rules.principles", "skill-dev-rules#rules.stable-artifacts", "skill-build#build.conformance", "skill-build#build.checklist", "skill-debug#debug.root-cause", "skill-debug#debug.hypotheses", "skill-debug#debug.fix-discipline", "skill-debug#debug.red-flags", "skill-test#test.behavior", "skill-test#test.error-paths", "layer-api-design", "layer-sql-quality", "layer-backend-security"]},
    {"id": "agent-web", "name": "Agent: web",
     "resources": ["skill-feature-flow#flow.needs-info", "layer-stack-react-vite", "layer-web-contract-first", "skill-maker#dev.implement-feature",
                   "skill-maker#dev.definition-of-done", "skill-tracker-dev#dev.stack-overview", "skill-dev-rules#rules.decisions", "skill-dev-rules#rules.finish", "skill-ask#ask.analysis-first", "skill-ask#ask.question-groups", "skill-dev-rules#rules.no-shortcuts", "skill-dev-rules#rules.principles", "skill-dev-rules#rules.stable-artifacts", "skill-build#build.conformance", "skill-build#build.checklist", "skill-debug#debug.root-cause", "skill-debug#debug.hypotheses", "skill-debug#debug.fix-discipline", "skill-debug#debug.red-flags", "skill-test#test.behavior", "skill-test#test.error-paths", "layer-react-quality", "layer-frontend-testing"]},
    {"id": "agent-reviewer", "from": "kit", "addResources": ["layer-openapi-contract", "layer-stack-spring-sqlite", "layer-api-contract-first", "layer-stack-react-vite", "layer-web-contract-first", "skill-maker#dev.definition-of-done", "skill-tracker-dev#dev.stack-overview"]},

    {"id": "agent-flow-brainstorm", "from": "kit", "addResources": ["skill-tracker-dev#dev.stack-overview"]},
    {"id": "agent-flow-spec", "from": "kit", "addResources": ["skill-tracker-dev#dev.stack-overview"]},
    {"id": "agent-flow-design", "from": "kit", "addResources": ["layer-openapi-contract", "layer-stack-spring-sqlite", "layer-api-contract-first", "layer-stack-react-vite", "layer-web-contract-first", "skill-tracker-dev#dev.stack-overview"]},
    {"id": "agent-flow-frame", "from": "kit", "addResources": []},
    {"id": "agent-flow-plan", "from": "kit", "addResources": ["skill-tracker-dev#dev.routing-table", "layer-openapi-contract", "layer-stack-spring-sqlite", "layer-api-contract-first", "layer-stack-react-vite", "layer-web-contract-first"]},
    {"id": "agent-flow-build", "from": "kit", "addResources": ["layer-openapi-contract", "layer-stack-spring-sqlite", "layer-api-contract-first", "layer-stack-react-vite", "layer-web-contract-first", "skill-maker#dev.definition-of-done"]},
    {"id": "agent-flow-sync", "from": "kit", "addResources": []},

    {"id": "agent-debugger", "from": "kit", "addResources": ["layer-openapi-contract", "layer-stack-spring-sqlite", "layer-api-contract-first", "layer-stack-react-vite", "layer-web-contract-first", "skill-tracker-dev#dev.stack-overview"]},
    {"id": "agent-simplifier", "from": "kit", "addResources": ["layer-openapi-contract", "layer-stack-spring-sqlite", "layer-api-contract-first", "layer-stack-react-vite", "layer-web-contract-first", "skill-tracker-dev#dev.stack-overview"]},
    {"id": "agent-flow-repro", "from": "kit", "addResources": ["layer-openapi-contract", "layer-stack-spring-sqlite", "layer-api-contract-first", "layer-stack-react-vite", "layer-web-contract-first", "skill-tracker-dev#dev.stack-overview"]},
    {"id": "agent-flow-fix", "from": "kit", "addResources": ["layer-openapi-contract", "layer-stack-spring-sqlite", "layer-api-contract-first", "layer-stack-react-vite", "layer-web-contract-first", "skill-maker#dev.definition-of-done", "skill-tracker-dev#dev.stack-overview"]}
  ],

  "commands": [
    {"id": "cmd-reject", "from": "kit"},
    {"id": "cmd-check-feature-docs", "from": "kit"},

    {"id": "cmd-contract-lint", "name": "Command: kiểm tra spec OpenAPI", "script": "scripts#contract-lint.sh", "repository": "contracts"},
    {"id": "cmd-contract-compat", "name": "Command: spec không phá vỡ bản đã commit", "script": "scripts#contract-compat.sh", "repository": "contracts"},
    {"id": "cmd-api-test", "from": "kit:cmd-maven-test", "name": "Command: test api (Maven)", "repository": "api"},
    {"id": "cmd-api-conformance", "name": "Command: route của api khớp hợp đồng", "script": "scripts#api-conformance.sh",
     "repository": "api", "argRepositories": ["contracts"]},
    {"id": "cmd-web-test", "from": "kit:cmd-npm-test", "name": "Command: test và build web (npm)", "repository": "web"},
    {"id": "cmd-api-temp-artifacts", "from": "kit:cmd-temp-artifacts", "name": "Command: chặn rác trong diff của api", "repository": "api"},
    {"id": "cmd-api-diff-size", "from": "kit:cmd-diff-size", "name": "Command: diff của api vượt ngưỡng thì làm gọn", "repository": "api"},
    {"id": "cmd-api-check-plan", "from": "kit:cmd-check-plan", "name": "Command: plan.md của task api đủ sáu mục", "repository": "api"},
    {"id": "cmd-web-temp-artifacts", "from": "kit:cmd-temp-artifacts", "name": "Command: chặn rác trong diff của web", "repository": "web"},
    {"id": "cmd-web-diff-size", "from": "kit:cmd-diff-size", "name": "Command: diff của web vượt ngưỡng thì làm gọn", "repository": "web"},
    {"id": "cmd-web-check-plan", "from": "kit:cmd-check-plan", "name": "Command: plan.md của task web đủ sáu mục", "repository": "web"},
    {"id": "cmd-api-expect-fail", "from": "kit:cmd-expect-fail", "name": "Command: test tái hiện lỗi của api phải đỏ", "repository": "api"},
    {"id": "cmd-web-expect-fail", "from": "kit:cmd-expect-fail", "name": "Command: test tái hiện lỗi của web phải đỏ", "repository": "web"},
    {"id": "cmd-web-conformance", "name": "Command: lời gọi của web khớp hợp đồng", "script": "scripts#web-conformance.sh",
     "repository": "web", "argRepositories": ["contracts"]},

    {"id": "cmd-secrets-gate-contracts", "from": "kit:cmd-secrets-gate", "repository": "contracts"},
    {"id": "cmd-secrets-gate-api", "from": "kit:cmd-secrets-gate", "repository": "api"},
    {"id": "cmd-secrets-gate-web", "from": "kit:cmd-secrets-gate", "repository": "web"},
    {"id": "cmd-contract-valid-gate", "name": "Command của gate: spec hợp lệ", "script": "scripts#contract-valid-gate.sh",
     "repository": "contracts", "repositoryArg": true, "timeoutSeconds": 120, "maxOutputBytes": 65536}
  ],

  "gates": [
    {"id": "gate-secrets-contracts", "from": "kit:gate-secrets", "command": "cmd-secrets-gate-contracts"},
    {"id": "gate-secrets-api", "from": "kit:gate-secrets", "command": "cmd-secrets-gate-api"},
    {"id": "gate-secrets-web", "from": "kit:gate-secrets", "command": "cmd-secrets-gate-web"},
    {"id": "gate-contract-valid", "name": "Gate: spec hợp lệ", "command": "cmd-contract-valid-gate",
     "criteria": [{"name": "spec/openapi.json là OpenAPI 3.0 hợp lệ", "evidenceKey": "SPEC_VALID"}]}
  ],

  "workflows": [
    {"id": "wf-contract-change", "name": "Workflow: đổi hợp đồng", "template": "definitions/workflows/wf-contract-change.json"},
    {"id": "wf-api-feature", "name": "Workflow: task api", "template": "definitions/workflows/wf-api-feature.json"},
    {"id": "wf-web-feature", "name": "Workflow: task web", "template": "definitions/workflows/wf-web-feature.json"},
    {"id": "wf-code-review", "name": "Workflow: review độc lập + người duyệt", "template": "definitions/workflows/wf-code-review.json"},
    {"id": "wf-main-check", "name": "Workflow: kiểm tra nhánh chính ba repository", "template": "definitions/workflows/wf-main-check.json"},

    {"id": "wf-feature-definition", "from": "kit"},
    {"id": "wf-task-delivery-contracts", "from": "kit:wf-task-delivery", "name": "Workflow: giao task ở repo contracts",
     "bind": {"command:cmd-gate1": "cmd-contract-lint", "command:cmd-quality-check": "cmd-contract-compat"}},
    {"id": "wf-task-delivery-api", "from": "kit:wf-task-delivery", "name": "Workflow: giao task ở repo api",
     "bind": {"command:cmd-gate1": "cmd-api-test", "command:cmd-quality-check": "cmd-api-conformance",
              "policy:policy-permission": "policy-permission-multirepo"}},
    {"id": "wf-task-delivery-web", "from": "kit:wf-task-delivery", "name": "Workflow: giao task ở repo web",
     "bind": {"command:cmd-gate1": "cmd-web-test", "command:cmd-quality-check": "cmd-web-conformance",
              "policy:policy-permission": "policy-permission-multirepo"}},

    {"id": "wf-task-delivery-plus-api", "from": "kit:wf-task-delivery-plus", "name": "Workflow: giao task ở repo api (chẩn đoán + review độc lập)",
     "bind": {"command:cmd-gate1": "cmd-api-test", "command:cmd-quality-check": "cmd-api-conformance",
              "command:cmd-temp-artifacts": "cmd-api-temp-artifacts", "command:cmd-diff-size": "cmd-api-diff-size",
              "command:cmd-check-plan": "cmd-api-check-plan",
              "policy:policy-permission": "policy-permission-multirepo"}},
    {"id": "wf-task-delivery-plus-web", "from": "kit:wf-task-delivery-plus", "name": "Workflow: giao task ở repo web (chẩn đoán + review độc lập)",
     "bind": {"command:cmd-gate1": "cmd-web-test", "command:cmd-quality-check": "cmd-web-conformance",
              "command:cmd-temp-artifacts": "cmd-web-temp-artifacts", "command:cmd-diff-size": "cmd-web-diff-size",
              "command:cmd-check-plan": "cmd-web-check-plan",
              "policy:policy-permission": "policy-permission-multirepo"}},
    {"id": "wf-bugfix-api", "from": "kit:wf-bugfix", "name": "Workflow: sửa lỗi ở repo api (test đỏ trước)",
     "bind": {"command:cmd-gate1": "cmd-api-test", "command:cmd-expect-fail": "cmd-api-expect-fail",
              "policy:policy-permission": "policy-permission-multirepo"}},
    {"id": "wf-bugfix-web", "from": "kit:wf-bugfix", "name": "Workflow: sửa lỗi ở repo web (test đỏ trước)",
     "bind": {"command:cmd-gate1": "cmd-web-test", "command:cmd-expect-fail": "cmd-web-expect-fail",
              "policy:policy-permission": "policy-permission-multirepo"}}
  ]
}
