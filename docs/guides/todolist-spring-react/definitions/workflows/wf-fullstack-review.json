{
  "schemaVersion": "1",
  "nodes": [
    {"key": "start", "type": "START", "outcomes": ["next"]},
    {"key": "implement", "type": "AGENT", "outcomes": ["done", "escalated"],
     "cyclePolicy": {"maxIterations": 4, "escalationOutcome": "escalated"},
     "agent": {"profileRef": {"$ref": "agent:agent-dev"},
               "policyRefs": [{"$ref": "policy:policy-attempt"}, {"$ref": "policy:policy-permission"}],
               "adapterBuildId": {"$ref": "adapter"}, "role": "MAKER"}},
    {"key": "backend-test", "type": "COMMAND", "outcomes": ["passed", "failed"],
     "command": {"commandRef": {"$ref": "command:cmd-backend-test"},
                 "policyRefs": [{"$ref": "policy:policy-attempt-once"}, {"$ref": "policy:policy-permission"}],
                 "failureOutcome": "failed"}},
    {"key": "frontend-test", "type": "COMMAND", "outcomes": ["passed", "failed"],
     "command": {"commandRef": {"$ref": "command:cmd-frontend-test"},
                 "policyRefs": [{"$ref": "policy:policy-attempt-once"}, {"$ref": "policy:policy-permission"}],
                 "failureOutcome": "failed"}},
    {"key": "ai-review", "type": "AGENT", "outcomes": ["approved", "rework"],
     "agent": {"profileRef": {"$ref": "agent:agent-reviewer"},
               "policyRefs": [{"$ref": "policy:policy-attempt"}, {"$ref": "policy:policy-permission"}],
               "adapterBuildId": {"$ref": "adapter"}, "role": "CHECKER"}},
    {"key": "review", "type": "APPROVAL", "outcomes": ["approved", "rework", "rejected"],
     "approval": {"authorizedRoles": ["operator"], "timeoutSeconds": 604800, "escalationOutcome": "rejected",
                  "requestedEvidenceKinds": ["COMMAND_EXECUTION"]}},
    {"key": "reject", "type": "COMMAND", "outcomes": ["done"],
     "command": {"commandRef": {"$ref": "command:cmd-reject"},
                 "policyRefs": [{"$ref": "policy:policy-attempt-once"}, {"$ref": "policy:policy-permission"}]}},
    {"key": "end", "type": "END"}
  ],
  "edges": [
    {"key": "start-implement", "from": "start", "outcome": "next", "to": "implement"},
    {"key": "implement-backend-test", "from": "implement", "outcome": "done", "to": "backend-test"},
    {"key": "backend-test-frontend-test", "from": "backend-test", "outcome": "passed", "to": "frontend-test"},
    {"key": "backend-test-implement", "from": "backend-test", "outcome": "failed", "to": "implement"},
    {"key": "frontend-test-ai-review", "from": "frontend-test", "outcome": "passed", "to": "ai-review"},
    {"key": "frontend-test-implement", "from": "frontend-test", "outcome": "failed", "to": "implement"},
    {"key": "ai-review-review", "from": "ai-review", "outcome": "approved", "to": "review"},
    {"key": "ai-review-rework-review", "from": "ai-review", "outcome": "rework", "to": "review"},
    {"key": "review-end", "from": "review", "outcome": "approved", "to": "end"},
    {"key": "review-implement", "from": "review", "outcome": "rework", "to": "implement"},
    {"key": "review-reject", "from": "review", "outcome": "rejected", "to": "reject"},
    {"key": "implement-reject", "from": "implement", "outcome": "escalated", "to": "reject"},
    {"key": "reject-end", "from": "reject", "outcome": "done", "to": "end"}
  ],
  "completionPolicyRef": {"$ref": "policy:policy-completion-reviewed"}
}
