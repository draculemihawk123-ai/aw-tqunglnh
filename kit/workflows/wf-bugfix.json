{
  "schemaVersion": "1",
  "nodes": [
    {"key": "start", "type": "START", "outcomes": ["next"]},
    {"key": "repro", "type": "AGENT", "outcomes": ["done", "needs_info", "escalated"],
     "cyclePolicy": {"maxIterations": 3, "escalationOutcome": "escalated"},
     "agent": {"profileRef": {"$ref": "agent:agent-flow-repro"},
               "policyRefs": [{"$ref": "policy:policy-attempt"}, {"$ref": "policy:policy-permission"}],
               "adapterBuildId": {"$ref": "adapter"}, "role": "MAKER"}},
    {"key": "expect-fail", "type": "COMMAND", "outcomes": ["passed", "failed"],
     "command": {"commandRef": {"$ref": "command:cmd-expect-fail"},
                 "policyRefs": [{"$ref": "policy:policy-attempt-once"}, {"$ref": "policy:policy-permission"}],
                 "failureOutcome": "failed"}},
    {"key": "fix", "type": "AGENT", "outcomes": ["done", "needs_info", "escalated"],
     "cyclePolicy": {"maxIterations": 5, "escalationOutcome": "escalated"},
     "agent": {"profileRef": {"$ref": "agent:agent-flow-fix"},
               "policyRefs": [{"$ref": "policy:policy-attempt"}, {"$ref": "policy:policy-permission"}],
               "adapterBuildId": {"$ref": "adapter"}, "role": "MAKER"}},
    {"key": "gate1", "type": "COMMAND", "outcomes": ["passed", "failed"],
     "command": {"commandRef": {"$ref": "command:cmd-gate1"},
                 "policyRefs": [{"$ref": "policy:policy-attempt-once"}, {"$ref": "policy:policy-permission"}],
                 "failureOutcome": "failed"}},
    {"key": "debug", "type": "AGENT", "outcomes": ["diagnosed", "needs_info"],
     "agent": {"profileRef": {"$ref": "agent:agent-debugger"},
               "policyRefs": [{"$ref": "policy:policy-attempt"}, {"$ref": "policy:policy-permission"}],
               "adapterBuildId": {"$ref": "adapter"}, "role": "CHECKER"}},
    {"key": "review", "type": "AGENT", "outcomes": ["approved", "rework"],
     "agent": {"profileRef": {"$ref": "agent:agent-reviewer"},
               "policyRefs": [{"$ref": "policy:policy-attempt"}, {"$ref": "policy:policy-permission"}],
               "adapterBuildId": {"$ref": "adapter"}, "role": "CHECKER"}},
    {"key": "gate2", "type": "APPROVAL", "outcomes": ["approved", "revise", "rejected"],
     "approval": {"authorizedRoles": ["operator"], "timeoutSeconds": 604800, "escalationOutcome": "rejected",
                  "requestedEvidenceKinds": ["COMMAND_EXECUTION", "AGENT_OUTPUT"]},
     "cyclePolicy": {"maxIterations": 3, "escalationOutcome": "rejected"}},
    {"key": "needs-info", "type": "APPROVAL", "outcomes": ["provided", "abandon"],
     "approval": {"authorizedRoles": ["operator"], "timeoutSeconds": 604800, "escalationOutcome": "abandon"},
     "cyclePolicy": {"maxIterations": 3, "escalationOutcome": "abandon"}},
    {"key": "reject", "type": "COMMAND", "outcomes": ["done"],
     "command": {"commandRef": {"$ref": "command:cmd-reject"},
                 "policyRefs": [{"$ref": "policy:policy-attempt-once"}, {"$ref": "policy:policy-permission"}]}},
    {"key": "end", "type": "END"}
  ],
  "edges": [
    {"key": "start-repro", "from": "start", "outcome": "next", "to": "repro"},
    {"key": "repro-expect-fail", "from": "repro", "outcome": "done", "to": "expect-fail"},
    {"key": "repro-needs-info", "from": "repro", "outcome": "needs_info", "to": "needs-info"},
    {"key": "repro-reject", "from": "repro", "outcome": "escalated", "to": "reject"},
    {"key": "expect-fail-fix", "from": "expect-fail", "outcome": "passed", "to": "fix"},
    {"key": "expect-fail-repro", "from": "expect-fail", "outcome": "failed", "to": "repro"},
    {"key": "fix-gate1", "from": "fix", "outcome": "done", "to": "gate1"},
    {"key": "fix-needs-info", "from": "fix", "outcome": "needs_info", "to": "needs-info"},
    {"key": "fix-reject", "from": "fix", "outcome": "escalated", "to": "reject"},
    {"key": "gate1-review", "from": "gate1", "outcome": "passed", "to": "review"},
    {"key": "gate1-debug", "from": "gate1", "outcome": "failed", "to": "debug"},
    {"key": "debug-fix", "from": "debug", "outcome": "diagnosed", "to": "fix"},
    {"key": "debug-needs-info", "from": "debug", "outcome": "needs_info", "to": "needs-info"},
    {"key": "review-gate2", "from": "review", "outcome": "approved", "to": "gate2"},
    {"key": "review-fix", "from": "review", "outcome": "rework", "to": "fix"},
    {"key": "gate2-end", "from": "gate2", "outcome": "approved", "to": "end"},
    {"key": "gate2-fix", "from": "gate2", "outcome": "revise", "to": "fix"},
    {"key": "gate2-reject", "from": "gate2", "outcome": "rejected", "to": "reject"},
    {"key": "needs-info-repro", "from": "needs-info", "outcome": "provided", "to": "repro"},
    {"key": "needs-info-reject", "from": "needs-info", "outcome": "abandon", "to": "reject"},
    {"key": "reject-end", "from": "reject", "outcome": "done", "to": "end"}
  ],
  "completionPolicyRef": {"$ref": "policy:policy-completion-reviewed"}
}
