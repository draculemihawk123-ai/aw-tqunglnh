{
  "schemaVersion": "1",
  "nodes": [
    {"key": "start", "type": "START", "outcomes": ["next"]},
    {"key": "brainstorm", "type": "AGENT", "outcomes": ["done", "escalated"],
     "cyclePolicy": {"maxIterations": 3, "escalationOutcome": "escalated"},
     "agent": {"profileRef": {"$ref": "agent:agent-flow-brainstorm"},
               "policyRefs": [{"$ref": "policy:policy-attempt"}, {"$ref": "policy:policy-permission"}],
               "adapterBuildId": {"$ref": "adapter"}, "role": "MAKER"}},
    {"key": "spec", "type": "AGENT", "outcomes": ["done", "needs_info", "escalated"],
     "cyclePolicy": {"maxIterations": 5, "escalationOutcome": "escalated"},
     "agent": {"profileRef": {"$ref": "agent:agent-flow-spec"},
               "policyRefs": [{"$ref": "policy:policy-attempt"}, {"$ref": "policy:policy-permission"}],
               "adapterBuildId": {"$ref": "adapter"}, "role": "MAKER"}},
    {"key": "check-brainstorm", "type": "COMMAND", "outcomes": ["passed", "failed"],
     "command": {"commandRef": {"$ref": "command:cmd-check-brainstorm"},
                 "policyRefs": [{"$ref": "policy:policy-attempt-once"}, {"$ref": "policy:policy-permission"}],
                 "failureOutcome": "failed"}},
    {"key": "check-spec", "type": "COMMAND", "outcomes": ["passed", "failed"],
     "command": {"commandRef": {"$ref": "command:cmd-check-spec"},
                 "policyRefs": [{"$ref": "policy:policy-attempt-once"}, {"$ref": "policy:policy-permission"}],
                 "failureOutcome": "failed"}},
    {"key": "needs-info", "type": "APPROVAL", "outcomes": ["provided", "abandon"],
     "approval": {"authorizedRoles": ["operator"], "timeoutSeconds": 604800, "escalationOutcome": "abandon"},
     "cyclePolicy": {"maxIterations": 3, "escalationOutcome": "abandon"}},
    {"key": "gate-a", "type": "APPROVAL", "outcomes": ["approved", "revise", "rejected"],
     "approval": {"authorizedRoles": ["operator"], "timeoutSeconds": 604800, "escalationOutcome": "rejected"},
     "cyclePolicy": {"maxIterations": 3, "escalationOutcome": "rejected"}},
    {"key": "design", "type": "AGENT", "outcomes": ["done", "escalated"],
     "cyclePolicy": {"maxIterations": 5, "escalationOutcome": "escalated"},
     "agent": {"profileRef": {"$ref": "agent:agent-flow-design"},
               "policyRefs": [{"$ref": "policy:policy-attempt"}, {"$ref": "policy:policy-permission"}],
               "adapterBuildId": {"$ref": "adapter"}, "role": "MAKER"}},
    {"key": "check-docs", "type": "COMMAND", "outcomes": ["passed", "failed"],
     "command": {"commandRef": {"$ref": "command:cmd-check-feature-docs"},
                 "policyRefs": [{"$ref": "policy:policy-attempt-once"}, {"$ref": "policy:policy-permission"}],
                 "failureOutcome": "failed"}},
    {"key": "gate-b", "type": "APPROVAL", "outcomes": ["approved", "revise", "rejected"],
     "approval": {"authorizedRoles": ["operator"], "timeoutSeconds": 604800, "escalationOutcome": "rejected",
                  "requestedEvidenceKinds": ["COMMAND_EXECUTION"]},
     "cyclePolicy": {"maxIterations": 3, "escalationOutcome": "rejected"}},
    {"key": "reject", "type": "COMMAND", "outcomes": ["done"],
     "command": {"commandRef": {"$ref": "command:cmd-reject"},
                 "policyRefs": [{"$ref": "policy:policy-attempt-once"}, {"$ref": "policy:policy-permission"}]}},
    {"key": "end", "type": "END"}
  ],
  "edges": [
    {"key": "start-brainstorm", "from": "start", "outcome": "next", "to": "brainstorm"},
    {"key": "brainstorm-check", "from": "brainstorm", "outcome": "done", "to": "check-brainstorm"},
    {"key": "brainstorm-reject", "from": "brainstorm", "outcome": "escalated", "to": "reject"},
    {"key": "check-brainstorm-spec", "from": "check-brainstorm", "outcome": "passed", "to": "spec"},
    {"key": "check-brainstorm-brainstorm", "from": "check-brainstorm", "outcome": "failed", "to": "brainstorm"},
    {"key": "spec-check", "from": "spec", "outcome": "done", "to": "check-spec"},
    {"key": "spec-reject", "from": "spec", "outcome": "escalated", "to": "reject"},
    {"key": "check-spec-gate-a", "from": "check-spec", "outcome": "passed", "to": "gate-a"},
    {"key": "check-spec-spec", "from": "check-spec", "outcome": "failed", "to": "spec"},
    {"key": "spec-needs-info", "from": "spec", "outcome": "needs_info", "to": "needs-info"},
    {"key": "needs-info-spec", "from": "needs-info", "outcome": "provided", "to": "spec"},
    {"key": "needs-info-reject", "from": "needs-info", "outcome": "abandon", "to": "reject"},
    {"key": "gate-a-design", "from": "gate-a", "outcome": "approved", "to": "design"},
    {"key": "gate-a-spec", "from": "gate-a", "outcome": "revise", "to": "spec"},
    {"key": "gate-a-reject", "from": "gate-a", "outcome": "rejected", "to": "reject"},
    {"key": "design-check-docs", "from": "design", "outcome": "done", "to": "check-docs"},
    {"key": "design-reject", "from": "design", "outcome": "escalated", "to": "reject"},
    {"key": "check-docs-gate-b", "from": "check-docs", "outcome": "passed", "to": "gate-b"},
    {"key": "check-docs-design", "from": "check-docs", "outcome": "failed", "to": "design"},
    {"key": "gate-b-end", "from": "gate-b", "outcome": "approved", "to": "end"},
    {"key": "gate-b-design", "from": "gate-b", "outcome": "revise", "to": "design"},
    {"key": "gate-b-reject", "from": "gate-b", "outcome": "rejected", "to": "reject"},
    {"key": "reject-end", "from": "reject", "outcome": "done", "to": "end"}
  ],
  "completionPolicyRef": {"$ref": "policy:policy-completion-feature"}
}
