{
  "schemaVersion": "1",
  "nodes": [
    {"key": "start", "type": "START", "outcomes": ["next"]},
    {"key": "frame", "type": "AGENT", "outcomes": ["fast", "full", "needs_info"],
     "agent": {"profileRef": {"$ref": "agent:agent-flow-frame"},
               "policyRefs": [{"$ref": "policy:policy-attempt"}, {"$ref": "policy:policy-permission"}],
               "adapterBuildId": {"$ref": "adapter"}, "role": "MAKER"}},
    {"key": "plan", "type": "AGENT", "outcomes": ["done"],
     "agent": {"profileRef": {"$ref": "agent:agent-flow-plan"},
               "policyRefs": [{"$ref": "policy:policy-attempt"}, {"$ref": "policy:policy-permission"}],
               "adapterBuildId": {"$ref": "adapter"}, "role": "MAKER"}},
    {"key": "build", "type": "AGENT", "outcomes": ["done", "needs_info", "escalated"],
     "cyclePolicy": {"maxIterations": 5, "escalationOutcome": "escalated"},
     "agent": {"profileRef": {"$ref": "agent:agent-flow-build"},
               "policyRefs": [{"$ref": "policy:policy-attempt"}, {"$ref": "policy:policy-permission"}],
               "adapterBuildId": {"$ref": "adapter"}, "role": "MAKER"}},
    {"key": "gate1", "type": "COMMAND", "outcomes": ["passed", "failed"],
     "command": {"commandRef": {"$ref": "command:cmd-gate1"},
                 "policyRefs": [{"$ref": "policy:policy-attempt-once"}, {"$ref": "policy:policy-permission"}],
                 "failureOutcome": "failed"}},
    {"key": "quality", "type": "COMMAND", "outcomes": ["passed", "failed"],
     "command": {"commandRef": {"$ref": "command:cmd-quality-check"},
                 "policyRefs": [{"$ref": "policy:policy-attempt-once"}, {"$ref": "policy:policy-permission"}],
                 "failureOutcome": "failed"}},
    {"key": "gate2", "type": "APPROVAL", "outcomes": ["approved", "revise", "rejected"],
     "approval": {"authorizedRoles": ["operator"], "timeoutSeconds": 604800, "escalationOutcome": "rejected",
                  "requestedEvidenceKinds": ["COMMAND_EXECUTION"]},
     "cyclePolicy": {"maxIterations": 3, "escalationOutcome": "rejected"}},
    {"key": "needs-info", "type": "APPROVAL", "outcomes": ["provided", "abandon"],
     "approval": {"authorizedRoles": ["operator"], "timeoutSeconds": 604800, "escalationOutcome": "abandon"},
     "cyclePolicy": {"maxIterations": 3, "escalationOutcome": "abandon"}},
    {"key": "sync", "type": "AGENT", "outcomes": ["done"],
     "agent": {"profileRef": {"$ref": "agent:agent-flow-sync"},
               "policyRefs": [{"$ref": "policy:policy-attempt"}, {"$ref": "policy:policy-permission"}],
               "adapterBuildId": {"$ref": "adapter"}, "role": "MAKER"}},
    {"key": "reject", "type": "COMMAND", "outcomes": ["done"],
     "command": {"commandRef": {"$ref": "command:cmd-reject"},
                 "policyRefs": [{"$ref": "policy:policy-attempt-once"}, {"$ref": "policy:policy-permission"}]}},
    {"key": "end", "type": "END"}
  ],
  "edges": [
    {"key": "start-frame", "from": "start", "outcome": "next", "to": "frame"},
    {"key": "frame-build", "from": "frame", "outcome": "fast", "to": "build"},
    {"key": "frame-plan", "from": "frame", "outcome": "full", "to": "plan"},
    {"key": "frame-needs-info", "from": "frame", "outcome": "needs_info", "to": "needs-info"},
    {"key": "plan-build", "from": "plan", "outcome": "done", "to": "build"},
    {"key": "build-gate1", "from": "build", "outcome": "done", "to": "gate1"},
    {"key": "build-needs-info", "from": "build", "outcome": "needs_info", "to": "needs-info"},
    {"key": "build-reject", "from": "build", "outcome": "escalated", "to": "reject"},
    {"key": "gate1-quality", "from": "gate1", "outcome": "passed", "to": "quality"},
    {"key": "gate1-build", "from": "gate1", "outcome": "failed", "to": "build"},
    {"key": "quality-gate2", "from": "quality", "outcome": "passed", "to": "gate2"},
    {"key": "quality-build", "from": "quality", "outcome": "failed", "to": "build"},
    {"key": "gate2-sync", "from": "gate2", "outcome": "approved", "to": "sync"},
    {"key": "gate2-build", "from": "gate2", "outcome": "revise", "to": "build"},
    {"key": "gate2-reject", "from": "gate2", "outcome": "rejected", "to": "reject"},
    {"key": "needs-info-frame", "from": "needs-info", "outcome": "provided", "to": "frame"},
    {"key": "needs-info-reject", "from": "needs-info", "outcome": "abandon", "to": "reject"},
    {"key": "sync-end", "from": "sync", "outcome": "done", "to": "end"},
    {"key": "reject-end", "from": "reject", "outcome": "done", "to": "end"}
  ],
  "completionPolicyRef": {"$ref": "policy:policy-completion-reviewed"}
}
