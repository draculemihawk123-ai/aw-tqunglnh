    {"id": "policy-permission-network", "name": "Permission: network allowed", "file": "policies/policy-permission-network.json"},
    {"id": "policy-completion", "name": "Completion: test PASS", "file": "policies/policy-completion.json"},
    {"id": "policy-completion-reviewed", "name": "Completion: tests PASS + reviewer", "file": "policies/policy-completion-reviewed.json"},
    {"id": "policy-completion-feature", "name": "Completion: document check + reviewer", "file": "policies/policy-completion-feature.json"}
  ],

