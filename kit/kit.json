  "commands": [
    {"id": "cmd-maven-test", "name": "Command: test backend Maven", "script": "scripts-common#maven-test.sh",
     "network": "ALLOWED", "policies": ["policy-permission-network"]},
    {"id": "cmd-npm-test", "name": "Command: frontend npm test and build", "script": "scripts-common#npm-test.sh",
     "network": "ALLOWED", "policies": ["policy-permission-network"]},
    {"id": "cmd-expect-fail", "name": "Command: the reproduction test must be red (inverted)", "script": "scripts-common#expect-fail.sh",
     "network": "ALLOWED", "policies": ["policy-permission-network"]},
    {"id": "cmd-diff-size", "name": "Command: a diff over the threshold goes to the simplify node", "script": "scripts-common#diff-size.sh"},
    {"id": "cmd-temp-artifacts", "name": "Command: block leftovers in the diff (debug, .only, @Disabled, TODO)", "script": "scripts-common#temp-artifacts.sh"},
    {"id": "cmd-check-plan", "name": "Command: the task's plan.md has all six sections", "script": "scripts-common#check-plan.sh"},
    {"id": "cmd-check-lessons", "name": "Command: the lessons file has the right format", "script": "scripts-common#check-lessons.sh"},
    {"id": "cmd-reject", "name": "Command: stop the run when rejected or out of fix rounds", "script": "scripts-common#reject.sh"},
    {"id": "cmd-check-feature-docs", "name": "Command: check the feature documents", "script": "scripts-common#check-feature-docs.sh"},
    {"id": "cmd-secrets-gate", "name": "Gate command: no secret files", "script": "scripts-common#secrets-gate.sh",
     "repositoryArg": true, "timeoutSeconds": 120, "maxOutputBytes": 65536}
  ],

  "gates": [
    {"id": "gate-secrets", "name": "Gate: no secret files", "command": "cmd-secrets-gate",
     "criteria": [{"name": "No secret file or database file", "evidenceKey": "NO_SECRET_FILES"}]}
  ],

  "workflows": [
    {"id": "wf-feature-definition", "name": "Workflow: define a feature", "template": "workflows/wf-feature-definition.json"},
    {"id": "wf-task-delivery", "name": "Workflow: deliver a task", "template": "workflows/wf-task-delivery.json"},
    {"id": "wf-task-delivery-plus", "name": "Workflow: deliver a task, with diagnosis when red and an independent review", "template": "workflows/wf-task-delivery-plus.json"},
    {"id": "wf-retro", "name": "Workflow: draw lessons from measurements, the reviewer approves before they become rules", "template": "workflows/wf-retro.json"},
    {"id": "wf-bugfix", "name": "Workflow: bug fix - red test first, fix after", "template": "workflows/wf-bugfix.json"}
  ]
}
