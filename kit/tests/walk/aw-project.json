    {
      "id": "walk-scripts",
      "name": "Script giả lập của walk-workflow",
      "owner": "aw-kit",
      "files": [
        "commands/gate1.sh",
        "commands/quality.sh",
        "commands/expectfail.sh",
        "commands/hygiene.sh",
        "commands/size.sh",
        "commands/checkplan.sh",
        "commands/checklessons.sh",
        "commands/checkbrainstorm.sh",
        "commands/checkspec.sh",
        "commands/checkdocs.sh"
      ]
    }
  ],
  "agents": [
