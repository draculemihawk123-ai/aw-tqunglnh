{
  "prefix": "walk-",
  "repository": "repo",
  "kit": {
    "path": "../../kit.json",
    "version": "1"
  },
  "provider": {
    "key": "claude",
    "model": "sonnet",
    "configIdentity": "walk-claude",
    "envAllowlist": [
      "HOME",
      "PATH"
    ]
  },
  "contextBudgetBytes": 65536,
  "messageBudget": {
    "maxBytes": 32768,
    "keepLatest": 2
  },
  "skills": [],
