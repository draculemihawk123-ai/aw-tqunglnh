{
  "prefix": "walk-",
  "repository": "repo",
  "kit": {"path": "../../kit.json", "version": "1"},
  "provider": {"key": "claude", "model": "sonnet", "configIdentity": "walk-claude", "envAllowlist": ["HOME", "PATH"]},
  "contextBudgetBytes": 65536,
  "messageBudget": {"maxBytes": 32768, "keepLatest": 2},

  "scriptSkills": [
    {"id": "walk-scripts", "name": "Script giả lập của walk-workflow", "owner": "aw-kit",
     "files": ["commands/gate1.sh", "commands/quality.sh", "commands/expectfail.sh"]}
  ],

  "agents": [
    {"id": "agent-flow-frame", "from": "kit"},
    {"id": "agent-flow-plan", "from": "kit"},
    {"id": "agent-flow-build", "from": "kit"},
    {"id": "agent-flow-sync", "from": "kit"},
    {"id": "agent-flow-repro", "from": "kit"},
    {"id": "agent-flow-fix", "from": "kit"},
    {"id": "agent-debugger", "from": "kit"},
    {"id": "agent-reviewer", "from": "kit"}
  ],

  "commands": [
    {"id": "cmd-reject", "from": "kit"},
    {"id": "cmd-gate1", "name": "Command giả lập: gate1", "script": "walk-scripts#gate1.sh"},
    {"id": "cmd-quality-check", "name": "Command giả lập: quality", "script": "walk-scripts#quality.sh"},
    {"id": "cmd-expect-fail", "name": "Command giả lập: expect-fail", "script": "walk-scripts#expectfail.sh"}
  ],

  "workflows": [
    {"id": "wf-task-delivery-plus", "from": "kit"},
    {"id": "wf-bugfix", "from": "kit"}
  ]
}
