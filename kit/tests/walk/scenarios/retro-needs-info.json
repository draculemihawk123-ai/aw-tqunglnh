{
  "name": "wf-retro: thiếu dữ liệu → người bổ sung → retro lại",
  "manifest": "../aw-project.json",
  "workflow": "wf-retro",
  "agents": {
    "retro": [
      "needs_info",
      "done"
    ]
  },
  "commands": {
    "checklessons": [
      "pass"
    ]
  },
  "approvals": {
    "needs-info": [
      "provided"
    ],
    "approve-lessons": [
      "approved"
    ]
  },
  "expect": {
    "state": "SUCCEEDED",
    "sequence": [
      "start:next",
      "retro:needs_info",
      "needs-info:provided",
      "retro:done",
      "check-lessons:passed",
      "approve-lessons:approved",
      "end:-"
    ]
  }
}
