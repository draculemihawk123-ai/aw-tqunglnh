{
  "manifest": "../aw-project.json",
  "workflow": "wf-feature-definition",
  "name": "wf-feature-definition: brainstorm thiếu mục → làm lại, prompt có checkFailures",
  "agents": {
    "brainstorm": [
      "done"
    ],
    "spec": [
      "done"
    ],
    "design": [
      "done"
    ]
  },
  "commands": {
    "checkbrainstorm": [
      "fail",
      "pass"
    ]
  },
  "approvals": {
    "gate-a": [
      "approved"
    ],
    "gate-b": [
      "approved"
    ]
  },
  "expect": {
    "state": "SUCCEEDED",
    "sequence": [
      "start:next",
      "brainstorm:done",
      "check-brainstorm:failed",
      "brainstorm:done",
      "check-brainstorm:passed",
      "spec:done",
      "check-spec:passed",
      "gate-a:approved",
      "design:done",
      "check-docs:passed",
      "gate-b:approved",
      "end:-"
    ],
    "prompts": [
      {
        "node": "brainstorm",
        "nth": 2,
        "has": [
          "\"checkFailures\":",
          "checkbrainstorm"
        ]
      },
      {
        "node": "brainstorm",
        "nth": 1,
        "lacks": [
          "\"checkFailures\":"
        ]
      }
    ]
  }
}
